---
// Header + supermenu (Work/News/About) + locale panel.
// Transcribed from design/handoff/design/MDMC Site.dc.html lines 30-107.
// Content is fetched once by Base.astro via loadContent() and passed down as
// props — this component never fetches on its own.
// The wordmark is inlined as a data URI (6KB, 400px = 4x its display size):
// as a fetched image it painted a frame late on every navigation — the box
// was reserved (no layout shift) but the pixels flashed in. Inlining ships
// it with the HTML, so it paints with first render. Vite's ?inline resolves
// this to a data: string at build time.
import logoDataUri from "../assets/mdmc-logo.png?inline";
import { makeT, makeLinks, pickLocalized } from "../lib/i18n.js";

interface ContentItem {
  slug: string;
  title: string;
}

interface Props {
  active?: "home" | "work" | "news" | "about" | "contact";
  locale?: "en" | "ja";
  site?: "co" | "cojp";
  // EN-shaped path of the current page (Base.astro computes this) — the
  // input every link below is built from, regardless of which (site, lang)
  // tree we're rendering.
  enPath?: string;
  projects: ContentItem[];
  articles: ContentItem[];
}

const { active, locale = "en", site = "co", enPath = "/", projects = [], articles = [] } = Astro.props as Props;
const t = makeT(locale);
const links = makeLinks(site, locale);
const href = (path: string) => links.internal(path);

const workItems = projects.slice(0, 4);
const newsItems = articles.slice(0, 4);

// Localized labels; ja leads with the local (Japan) studio, same principle
// as studiosForLocale. The client script keeps these exact labels via the
// data-region-labels attribute below (it's a bundled script, no server vars).
// Region rows (2026-08-21 matrix model): a row for the domain you're already
// on is a preference BUTTON (stores mdmc.region, no navigation); a row for
// the other domain is a LINK to this page's counterpart there, carrying the
// current language. NZ/AU both live on mdmc.co — which one you picked rides
// along as ?r= so the destination (a different origin, different
// localStorage) can adopt it. On co.jp the region is always Japan (the
// domain IS the region), so nz/au are links out and jp is the button.
const regionRows = [
  { code: "nz", label: t("work.region.New Zealand"), href: site === "cojp" ? links.toSite("co", enPath) + "?r=nz" : null },
  { code: "au", label: t("work.region.Australia"), href: site === "cojp" ? links.toSite("co", enPath) + "?r=au" : null },
  { code: "jp", label: t("work.region.Japan"), href: site === "co" ? links.toSite("cojp", enPath) : null },
];
const regions = site === "cojp" ? [regionRows[2], regionRows[0], regionRows[1]] : regionRows;
const regionLabelsJson = JSON.stringify(Object.fromEntries(regionRows.map((r) => [r.code, r.label])));
// Language rows switch language ON THE CURRENT DOMAIN (relative links) —
// language never changes your region. Row labels never translate (the
// English row always reads "English", even on a ja page).
const languages = [
  { code: "en", label: t("lang.en"), href: links.toLang("en", enPath) },
  { code: "ja", label: t("lang.ja"), href: links.toLang("ja", enPath) },
];

// Server-rendered defaults. Region is a stored client preference on mdmc.co
// (nz/au; default nz) and FIXED to jp on co.jp; the client script may
// override from localStorage/?r= on mdmc.co only. Locale is NOT a
// preference at all: the URL is the single source of truth, so the language
// UI always renders the page's own locale.
const defaultRegion = site === "cojp" ? "jp" : "nz";
const defaultLocale = locale;
const defaultRegionLabel = regionRows.find((r) => r.code === defaultRegion)?.label ?? regionRows[0].label;
---

<header
  data-header
  data-page-locale={locale}
  data-page-site={site}
  style="position: relative; z-index: 100; background: #fff; display: grid; grid-template-columns: auto auto 1fr auto; align-items: center; padding: 64px var(--gutter-r) 36px var(--gutter-l); font-size: var(--text)"
>
  <a href={href("/")} aria-label={t("a11y.homeLink")} style="display: flex; align-items: center; gap: 14px; justify-self: start">
    {/* width/height attrs reserve the box pre-decode; the data-URI src makes
        the pixels part of the document so nothing flashes on navigation. */}
    <img src={logoDataUri} alt="MDMC" width="400" height="94" style="height: 22px; width: auto; aspect-ratio: 400 / 94">
  </a>

  <nav aria-label={t("a11y.primaryNav")} style="justify-self: start; display: flex; gap: 72px; margin-left: 225px">
    <a
      href={href("/work/")}
      data-mega-trigger="work"
      class:list={["nav-link", { "is-active": active === "work" }]}
    >{t("nav.work")}</a>
    <a
      href={href("/news/")}
      data-mega-trigger="news"
      class:list={["nav-link", { "is-active": active === "news" }]}
    >{t("nav.news")}</a>
    <a
      href={href("/about/")}
      data-mega-trigger="about"
      class:list={["nav-link", { "is-active": active === "about" }]}
    >{t("nav.about")}</a>
    <a
      href={href("/contact/")}
      data-mega-close
      class:list={["nav-link", { "is-active": active === "contact" }]}
    >{t("nav.contact")}</a>
  </nav>

  <div class="header-spacer"></div>

  <div style="justify-self: end; display: inline-flex; align-items: baseline; gap: 28px">
    <button
      type="button"
      data-mega-trigger="locale"
      aria-haspopup="true"
      class="locale-trigger"
      style="padding: 6px 0; font-size: 16px; color: #000; white-space: nowrap; display: inline-flex; align-items: baseline; gap: 10px"
    >
      <span data-locale-label data-region-labels={regionLabelsJson}>{defaultRegionLabel}</span>
      <span data-locale-code style="font-size: var(--label); letter-spacing: 0.14em; color: var(--muted); position: relative; top: -1px">{defaultLocale.toUpperCase()}</span>
    </button>
  </div>

  {/* Below-1024 nav (2026-09-03). The supermenu opens on mouseenter only, so
      before this existed no touch user could reach its four panels — 17 links
      shipped as unreachable DOM. This renders the same data as a full-screen
      dialog, and the hover panel stops rendering below 1024 so nothing is
      shipped twice.

      It lives INSIDE <header> deliberately: every region/locale handler in
      the script below is scoped to `header` (header.querySelectorAll(
      '[data-region]') etc.), so the drawer's region buttons and language
      links inherit the whole preference mechanism — localStorage, the ?r=
      carry, label refresh, active states — instead of duplicating it.

      <dialog> is deliberate too: showModal() gives focus containment,
      Escape and a backdrop natively, none of which this codebase has. */}
  <button
    type="button"
    data-drawer-open
    class="drawer-trigger"
    aria-expanded="false"
    aria-label={t("a11y.openMenu")}
  >
    <span class="drawer-bar" aria-hidden="true"></span>
    <span class="drawer-bar" aria-hidden="true"></span>
  </button>

  <dialog data-drawer class="drawer" aria-label={t("a11y.primaryNav")}>
    <div class="drawer-head">
      <span class="label">{t("nav.menu")}</span>
      <button type="button" data-drawer-close class="drawer-close" aria-label={t("a11y.closeMenu")}>
        <span aria-hidden="true">✕</span>
      </button>
    </div>

    <nav class="drawer-nav" aria-label={t("a11y.primaryNav")}>
      <a href={href("/work/")} class:list={["drawer-link", { "is-active": active === "work" }]}>{t("nav.work")}</a>
      <a href={href("/news/")} class:list={["drawer-link", { "is-active": active === "news" }]}>{t("nav.news")}</a>
      <a href={href("/about/")} class:list={["drawer-link", { "is-active": active === "about" }]}>{t("nav.about")}</a>
      <a href={href("/careers/")} class="drawer-link">{t("nav.careers")}</a>
      <a href={href("/contact/")} class:list={["drawer-link", { "is-active": active === "contact" }]}>{t("nav.contact")}</a>
    </nav>

    {workItems.length > 0 && (
      <div class="drawer-section">
        <span class="label">{t("work.title")}</span>
        <ul>
          {workItems.map((p) => (
            <li><a href={href(`/work/${p.slug}/`)} class="drawer-sublink">{pickLocalized(locale, p, "title")}</a></li>
          ))}
        </ul>
      </div>
    )}

    {newsItems.length > 0 && (
      <div class="drawer-section">
        <span class="label">{t("news.title")}</span>
        <ul>
          {newsItems.slice(0, 3).map((n) => (
            <li><a href={href(`/news/${n.slug}/`)} class="drawer-sublink">{pickLocalized(locale, n, "title")}</a></li>
          ))}
        </ul>
      </div>
    )}

    <div class="drawer-section">
      <span class="label">{t("nav.region")}</span>
      <ul class="drawer-inline">
        {regions.map((r) => (
          <li>{r.href ? (
            <a href={r.href} data-region={r.code} data-region-link class="drawer-chip">{r.label}</a>
          ) : (
            <button
              type="button"
              data-region={r.code}
              class:list={["drawer-chip", { "is-active": r.code === defaultRegion }]}
            >{r.label}</button>
          )}</li>
        ))}
      </ul>
    </div>

    <div class="drawer-section">
      <span class="label">{t("nav.language")}</span>
      <ul class="drawer-inline">
        {languages.map((l) => (
          <li><a
            href={l.href}
            data-locale={l.code}
            data-locale-link
            class:list={["drawer-chip", { "is-active": l.code === defaultLocale }]}
          >{l.label}</a></li>
        ))}
      </ul>
    </div>
  </dialog>

  <div
    data-mega
    aria-hidden="true"
    style="position: absolute; top: 100%; left: 0; right: 0; background: #fff; border-top: 1px solid var(--hairline); box-shadow: 0 1px 0 rgba(0,0,0,0.12), 0 32px 56px -40px rgba(0,0,0,0.18); overflow: hidden; opacity: 0; visibility: hidden; pointer-events: none; transform: translateY(-8px)"
  >
    <div style="padding: 40px var(--gutter-r) 48px var(--gutter-l)">
      <div data-panel="work">
        <div class="label" style="margin-bottom: 18px">{t("work.title")}</div>
        <ul style="list-style: none">
          {workItems.map((p) => (
            <li style="margin-top: 10px">
              <a href={href(`/work/${p.slug}/`)} class="mega-link" style="font-size: var(--text)">{pickLocalized(locale, p, "title")}</a>
            </li>
          ))}
        </ul>
      </div>

      <div data-panel="news" hidden>
        <div class="label" style="margin-bottom: 18px">{t("news.title")}</div>
        <ul style="list-style: none">
          {newsItems.map((n) => (
            <li style="margin-top: 10px">
              <a href={href(`/news/${n.slug}/`)} class="mega-link" style="font-size: var(--text)">{pickLocalized(locale, n, "title")}</a>
            </li>
          ))}
        </ul>
      </div>

      <div data-panel="about" hidden>
        <div style="display: flex; align-items: baseline; margin-bottom: 18px">
          <div style="flex: 0 0 335px" class="label">{t("nav.about")}</div>
        </div>
        <ul style="list-style: none">
          <li style="margin-top: 10px"><a href={href("/about/")} class="mega-link" style="font-size: var(--text)">{t("nav.about")}</a></li>
          <li style="margin-top: 10px"><a href={href("/careers/")} class="mega-link" style="font-size: var(--text)">{t("nav.careers")}</a></li>
        </ul>
      </div>

      <div data-panel="locale" hidden>
        <div style="display: flex; justify-content: flex-end; gap: 64px">
          <div style="width: 260px">
            <div class="label" style="margin-bottom: 18px; text-align: right">{t("nav.region")}</div>
            <ul style="list-style: none">
              {regions.map((r) => (
                <li style="margin-top: 10px">
                  {r.href ? (
                    <a
                      href={r.href}
                      data-region={r.code}
                      data-region-link
                      class="mega-link locale-btn"
                      style="display: block; width: 100%; text-align: right; font-size: var(--text)"
                    >{r.label}</a>
                  ) : (
                    <button
                      type="button"
                      data-region={r.code}
                      class:list={["mega-link", "locale-btn", { "is-active": r.code === defaultRegion }]}
                      style="display: block; width: 100%; text-align: right; font-size: var(--text)"
                    >{r.label}</button>
                  )}
                </li>
              ))}
            </ul>
          </div>
          <div style="width: 180px">
            <div class="label" style="margin-bottom: 18px; text-align: right">{t("nav.language")}</div>
            <ul style="list-style: none">
              {languages.map((l) => (
                <li style="margin-top: 10px">
                  <a
                    href={l.href}
                    data-locale={l.code}
                    data-locale-link
                    class:list={["mega-link", "locale-btn", { "is-active": l.code === defaultLocale }]}
                    style="display: block; width: 100%; text-align: right; font-size: var(--text)"
                  >{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* Responsive (2026-08-24): the handoff is desktop-only, so below 1024px
     (where the .zoom world ends) the header reflows — tablet drops the fixed
     225px nav offset; mobile goes two-row (logo + locale trigger up top, nav
     on its own row). Inline layout styles on the elements win the cascade,
     hence the !important overrides here, scoped to this component. */
  /* The wordmark shrinks with the header. The inline height:22px on the img
     is from the desktop handoff, hence !important. Aspect ratio is held by
     the element's own aspect-ratio + width:auto, so only height is set. */
  @media (max-width: 1023px) {
    header[data-header] img[alt="MDMC"] { height: 18px !important; }
  }
  @media (max-width: 700px) {
    header[data-header] img[alt="MDMC"] { height: 16px !important; }
  }

  /* --- Drawer (2026-09-03) ------------------------------------------------
     Desktop never renders the trigger or the dialog; below 1024 the header
     collapses to wordmark + hamburger and everything else moves inside. */
  .drawer-trigger,
  .drawer {
    display: none;
  }

  @media (max-width: 1023px) {
    .drawer-trigger {
      display: inline-flex !important;
      flex-direction: column;
      justify-content: center;
      gap: 6px;
      justify-self: end;
      min-width: var(--tap);
      min-height: var(--tap);
      align-items: flex-end;
    }
    .drawer-bar {
      display: block;
      width: 26px;
      height: 1px;
      background: var(--ink);
    }

    .drawer[open] {
      display: flex;
      flex-direction: column;
      gap: var(--sp-5);
      position: fixed;
      inset: 0;
      width: 100%;
      max-width: none;
      height: 100%;
      max-height: none;
      margin: 0;
      border: 0;
      padding: var(--sp-4) var(--gutter-r) var(--sp-6) var(--gutter-l);
      background: var(--paper);
      color: var(--ink);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .drawer::backdrop { background: rgba(0, 0, 0, 0.4); }

    .drawer-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .drawer-close {
      min-width: var(--tap);
      min-height: var(--tap);
      display: inline-flex;
      align-items: center;
      justify-content: flex-end;
      font-size: var(--text);
    }

    .drawer-nav { display: flex; flex-direction: column; }
    .drawer-link {
      font-size: var(--text-l);
      min-height: var(--tap);
      display: inline-flex;
      align-items: center;
      box-shadow: inset 0 -1px 0 var(--hairline);
    }
    /* Active row matches the site's nav convention — underline only, no
       weight change (see the NAV_SECTION note on .nav-link). */
    .drawer-link.is-active {
      text-decoration: underline;
      text-underline-offset: 6px;
    }

    .drawer-section > .label { display: block; margin-bottom: var(--sp-2); }
    .drawer-section ul { list-style: none; }
    .drawer-sublink {
      font-size: var(--text);
      min-height: var(--tap);
      display: inline-flex;
      align-items: center;
    }
    .drawer-inline {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--sp-4);
    }
    .drawer-chip {
      min-height: var(--tap);
      display: inline-flex;
      align-items: center;
      font-size: var(--text);
    }
    .drawer-chip.is-active {
      text-decoration: underline;
      text-underline-offset: 5px;
    }

    /* The inline nav, the spacer, the locale trigger and the hover panel all
       move into the drawer below 1024. Not rendering the panel keeps its 17
       links from shipping twice. */
    header[data-header] > nav,
    header[data-header] .header-spacer,
    header[data-header] > div:has(.locale-trigger),
    header[data-header] [data-mega] {
      display: none !important;
    }
  }

  /* Touch floor (2026-09-03). !important is required: these carry inline
     layout styles from the handoff transcription, the established pattern in
     this component (see the note above). Grown by min-height only — type
     size and visual weight are unchanged. */
  @media (max-width: 1023px) {
    header[data-header] > a,
    header[data-header] .nav-link,
    header[data-header] .locale-trigger,
    header[data-header] .mega-link {
      min-height: var(--tap) !important;
      display: inline-flex !important;
      align-items: center !important;
    }
  }

  @media (max-width: 1023px) {
    header[data-header] {
      /* Compact header (2026-09-03). The hamburger's 44px tap floor sets the
         content height, so the reduction comes out of padding: 36/24 was
         sized for the two-row layout that no longer exists below 1024.
         Header goes 104px -> 70px at 768. */
      padding-top: 12px !important;
      padding-bottom: 10px !important;
      /* Drop the 1fr spacer track and make the nav's own track the flexible
         one — the ja nav (私たちについて…) is wider than a tablet leaves
         room for, and only a minmax(0,1fr) track lets it shrink. */
      grid-template-columns: auto minmax(0, 1fr) auto !important;
    }
    .header-spacer { display: none; }
    header[data-header] > nav {
      margin-left: 32px !important;
      gap: 14px 24px !important;
      /* The inline justify-self:start sizes the nav to max-content and lets
         it overflow the page; stretch confines it to its track. min-width:0
         lets the track actually shrink; flex-wrap then breaks a too-wide ja
         nav onto a second line instead of clipping links (a hidden
         scrollbar gave no hint お問い合わせ existed off-screen). */
      justify-self: stretch !important;
      min-width: 0;
      flex-wrap: wrap;
    }
  }
  @media (max-width: 700px) {
    header[data-header] {
      grid-template-columns: auto 1fr !important;
      /* row-gap was for the old two-row header (nav on its own row); the nav
         lives in the drawer now, so there is no second row to space. */
      padding-top: 8px !important;
      padding-bottom: 8px !important;
      font-size: 17px !important;
    }
    header[data-header] > nav {
      grid-row: 2;
      grid-column: 1 / -1;
      /* A grid item never shrinks below its content without this pair — the
         ja nav row (私たちについて…) would otherwise widen the whole page
         (justify-self must beat the inline `start`, which sizes the nav to
         max-content regardless of min-width). Too-wide ja navs wrap to a
         second row (same rationale as the tablet block). */
      min-width: 0;
      justify-self: stretch !important;
      margin-left: 0 !important;
      gap: 12px 22px !important;
      flex-wrap: wrap;
    }
    header[data-header] .locale-trigger { font-size: var(--text-s) !important; grid-column: 2; }
    /* Locale panel: the right-aligned 260px+180px column pair overflows a
       phone — stack the two lists, still right-aligned. */
    [data-panel="locale"] > div { flex-direction: column !important; gap: 36px !important; align-items: flex-end; }
    [data-panel="locale"] > div > div { width: auto !important; min-width: 180px; }
  }

  .nav-link {
    position: relative;
    padding: 6px 0;
    white-space: nowrap;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .nav-link:hover,
  .nav-link.is-active {
    border-bottom-color: currentColor;
  }

  .locale-trigger {
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .locale-trigger:hover {
    border-bottom-color: currentColor;
  }

  .mega-link {
    transition: opacity 0.2s ease;
  }
  .mega-link:hover {
    opacity: 0.55;
  }

  .locale-btn {
    color: var(--muted);
  }
  .locale-btn.is-active {
    color: #000;
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const panel = header.querySelector('[data-mega]');
  const views = panel.querySelectorAll('[data-panel]');
  let open = null;

  function show(name) {
    views.forEach((v) => {
      v.hidden = v.dataset.panel !== name;
    });
    panel.style.opacity = '1';
    panel.style.visibility = 'visible';
    panel.style.pointerEvents = 'auto';
    panel.style.transform = 'translateY(0)';
    panel.setAttribute('aria-hidden', 'false');
    open = name;
  }
  function hide() {
    panel.style.opacity = '0';
    panel.style.visibility = 'hidden';
    panel.style.pointerEvents = 'none';
    panel.style.transform = 'translateY(-8px)';
    panel.setAttribute('aria-hidden', 'true');
    open = null;
  }
  header.querySelectorAll('[data-mega-trigger]').forEach((el) =>
    el.addEventListener('mouseenter', () => show(el.dataset.megaTrigger)));
  header.querySelectorAll('[data-mega-close]').forEach((el) =>
    el.addEventListener('mouseenter', hide));
  header.addEventListener('mouseleave', hide);
  panel.style.transition = 'opacity .25s var(--ease), transform .25s var(--ease), visibility .25s';
  hide();

  // mouseenter alone is inert for keyboard and touch users — the locale
  // trigger also needs a click handler that toggles the panel open/closed.
  const localeTrigger = header.querySelector('[data-mega-trigger="locale"]');
  if (localeTrigger) {
    localeTrigger.addEventListener('click', () => {
      if (open === 'locale') hide();
      else show('locale');
    });
  }

  // Escape closes whatever panel is open, for keyboard users.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) hide();
  });

  // Explicit cross-component contract: other components (e.g. Footer's
  // bottom-bar locale buttons) open a named mega panel by dispatching this
  // event rather than simulating a mouseenter on a trigger element — keeps
  // callers working even if this component's internals change.
  document.addEventListener('mdmc:open-mega', (e) => {
    const name = e.detail;
    if (name) show(name);
    else hide();
  });

  // --- Drawer (2026-09-03) -----------------------------------------------
  // <dialog>.showModal() covers focus containment, Escape and the backdrop.
  // What it does NOT cover: background scroll, and surviving a navigation —
  // the site uses cross-document view transitions, so a drawer left open
  // would still be painted over the incoming page as it fades in.
  const drawer = header.querySelector('[data-drawer]') as HTMLDialogElement | null;
  const drawerOpen = header.querySelector('[data-drawer-open]');
  const drawerClose = header.querySelector('[data-drawer-close]');
  if (drawer && drawerOpen) {
    const open = () => {
      if (drawer.open) return;
      drawer.showModal();
      drawerOpen.setAttribute('aria-expanded', 'true');
      // Scroll lock on the root rather than position:fixed on body, which
      // would lose the scroll position. The reserved scrollbar-gutter in
      // global.css means this does not change the page width.
      document.documentElement.style.overflow = 'hidden';
    };
    const close = () => { if (drawer.open) drawer.close(); };
    // 'close' fires for Escape and for .close() alike, so the teardown lives
    // here rather than in each caller.
    drawer.addEventListener('close', () => {
      drawerOpen.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
    });
    drawerOpen.addEventListener('click', open);
    drawerClose?.addEventListener('click', close);
    drawer.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      // Backdrop click: the event target is the dialog itself only when the
      // click landed outside its content box.
      if (target === drawer) { close(); return; }
      // Any in-drawer navigation must close it — see the view-transition note.
      // Region preference BUTTONS do not navigate, so they stay open and the
      // shared region handler below repaints their active state in place.
      if (target.closest('a')) close();
    });
    addEventListener('pagehide', close);
    // Crossing into the zoom world hides the trigger, so a drawer left open
    // there would have no visible way to close.
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches) close();
    });
  }

  // Region persistence — clicks write localStorage and refresh the trigger
  // label + active states. Language is deliberately NOT persisted: the URL
  // (domain/path) is the single source of truth for locale, so the language
  // UI below always renders the page's own locale. Language rows are plain
  // cross-domain links — the destination page renders its own state.
  const REGION_KEY = 'mdmc.region';
  // Localized region names ride in on data-region-labels (see the
  // [data-locale-label] span) — EN literals stay as the no-JS-attr fallback.
  let REGION_LABELS: Record<string, string> = { nz: 'New Zealand', au: 'Australia', jp: 'Japan' };
  try {
    const src = document.querySelector('[data-locale-label]') as HTMLElement | null;
    if (src?.dataset.regionLabels) REGION_LABELS = { ...REGION_LABELS, ...JSON.parse(src.dataset.regionLabels) };
  } catch { /* keep EN fallback */ }

  // localStorage can throw (Safari private mode, storage disabled by
  // policy, etc.) — these guards keep the locale UI working in-memory for
  // the current page view even when persistence itself is unavailable.
  function readStore(key) {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }
  function writeStore(key, value) {
    try {
      localStorage.setItem(key, value);
    } catch {
      /* ignore — persistence unavailable, UI still updates in-memory */
    }
  }

  const pageLocale = header.dataset.pageLocale === 'ja' ? 'ja' : 'en';
  const pageSite = header.dataset.pageSite === 'cojp' ? 'cojp' : 'co';
  // On co.jp the region IS the domain (always jp); on mdmc.co the stored
  // preference distinguishes nz/au (default nz).
  const defaultRegion = pageSite === 'cojp' ? 'jp' : 'nz';
  function normalizeRegion(v) {
    if (pageSite === 'cojp') return 'jp';
    return v === 'nz' || v === 'au' ? v : defaultRegion;
  }
  // One-time hygiene: nothing reads mdmc.locale any more (see comment
  // above) — clear stale values so old visits can't confuse anyone reading
  // storage by hand either.
  try { localStorage.removeItem('mdmc.locale'); } catch { /* fine */ }

  // Cross-domain region carry: localStorage can't cross origins, so region
  // links from the other domain append ?r=nz|au — adopt it, then strip the
  // param from the address bar.
  try {
    const url = new URL(location.href);
    const r = url.searchParams.get('r');
    if (r === 'nz' || r === 'au') {
      writeStore(REGION_KEY, r);
      url.searchParams.delete('r');
      history.replaceState(history.state, '', url.pathname + url.search + url.hash);
    }
  } catch { /* fine — preference just falls back to the default */ }

  // In-memory fallback so clicks still update the UI within this page view
  // even when readStore/writeStore can't touch localStorage at all.
  let memRegion = normalizeRegion(readStore(REGION_KEY));

  function renderLocaleUI() {
    const region = normalizeRegion(readStore(REGION_KEY) ?? memRegion);

    const labelEl = header.querySelector('[data-locale-label]');
    if (labelEl) labelEl.textContent = REGION_LABELS[region];
    // The locale code + active language row are server-rendered from the
    // page's own locale and never change client-side; re-assert them anyway
    // so a stale bfcache/localStorage state can never win.
    const codeEl = header.querySelector('[data-locale-code]');
    if (codeEl) codeEl.textContent = pageLocale.toUpperCase();

    header.querySelectorAll('[data-region]').forEach((btn) => {
      btn.classList.toggle('is-active', btn.dataset.region === region);
    });
    header.querySelectorAll('[data-locale]').forEach((btn) => {
      btn.classList.toggle('is-active', btn.dataset.locale === pageLocale);
    });
  }

  // Only the preference BUTTONS store locally; region LINKS ([data-region-link])
  // navigate to the other domain and hand the choice over via ?r= instead.
  header.querySelectorAll('button[data-region]').forEach((btn) => {
    btn.addEventListener('click', () => {
      memRegion = btn.dataset.region;
      writeStore(REGION_KEY, memRegion);
      renderLocaleUI();
      hide();
    });
  });
  renderLocaleUI();
</script>
