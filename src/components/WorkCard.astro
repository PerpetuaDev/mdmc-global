---
// Work grid card — transcribed from design/handoff/design/MDMC Site.dc.html
// lines 138-146 (the `allProjects` sc-for inside the home work grid; the
// Work index page in Phase 2 reuses the identical markup at lines 178-186).
// Missing `thumbnail` renders the same grey `var(--ph)` placeholder box the
// prototype uses for all images — today 3 of 6 live projects have none.
import { makeT, pickLocalized, makeLinks } from "../lib/i18n.js";

interface Props {
  project: {
    slug: string;
    title: string;
    description: string;
    thumbnail: { url: string; alt: string } | null;
  };
  headingLevel?: "h2" | "h3";
  locale?: "en" | "ja";
  site?: "co" | "cojp";
}

const { project, headingLevel = "h3", locale = "en", site = "co" } = Astro.props as Props;
const links = makeLinks(site, locale);
const Heading = headingLevel;
const t = makeT(locale);
const title = pickLocalized(locale, project, "title");
const description = pickLocalized(locale, project, "description");
---

<a href={links.internal(`/work/${project.slug}/`)} class="work-card">
  <div class="work-card-image">
    {project.thumbnail ? (
      <img src={project.thumbnail.url} alt={project.thumbnail.alt || title} />
    ) : (
      <div class="work-card-placeholder" aria-hidden="true"></div>
    )}
  </div>
  <Heading class="work-card-title">{title}</Heading>
  <p class="work-card-desc">{description}</p>
  <span class="work-card-cta">{t("home.work.view")} <span class="arrow">→</span></span>
</a>

<style>
  .work-card {
    display: block;
    cursor: pointer;
  }

  .work-card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--ph);
    overflow: hidden;
    position: relative;
    transition: transform 0.5s var(--ease);
  }
  .work-card:hover .work-card-image {
    transform: translateY(-4px);
  }

  .work-card-image img,
  .work-card-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work-card-title {
    font-size: var(--text-l);
    font-weight: 500;
    letter-spacing: -0.005em;
    margin-top: 24px;
  }

  .work-card-desc {
    margin-top: 8px;
    max-width: 460px;
  }

  .work-card-cta {
    margin-top: 20px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    /* The underline was simply missing: this had no border and no hover rule,
       so "View project" never responded to hover on any card. Mechanism is the
       global .cta class's — a transparent border reserved up front so the
       underline costs no layout shift when it appears, transitioned rather
       than snapping. It spans the arrow as well, which is what .cta does
       elsewhere on the site. */
    border-bottom: 1px solid transparent;
    transition: border-color .2s ease;
  }

  /* Triggered by the CARD, not the CTA: the whole card is one <a>, so the
     affordance belongs to hovering the card — matching the image effect
     directly above. :focus-visible gives keyboard users the same cue. */
  .work-card:hover .work-card-cta,
  .work-card:focus-visible .work-card-cta {
    border-bottom-color: currentColor;
  }
</style>
