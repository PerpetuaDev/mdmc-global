---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { loadContent, heroSlidesOf } from "../lib/content.js";
import { enPathOf, SITES } from "../lib/i18n.js";
import { organizationGraph, jsonLd } from "../lib/structured-data.js";

interface Props {
  title: string;
  description?: string;
  active?: "home" | "work" | "news" | "about" | "contact";
  locale?: "en" | "ja";
  // Which domain this tree is rendered FOR (region axis): "co" = mdmc.co,
  // "cojp" = mdmc.co.jp. See the 2026-08-21 language-region-matrix plan doc.
  site?: "co" | "cojp";
  // TEMPORARY back-compat: /ja/about/ still passes the old `lang` prop.
  // `locale` wins when both are given. A later task removes `lang` for good.
  lang?: string;
  ogImage?: string;
  // 404 has no ja counterpart (and no en counterpart either, really — it's
  // not a "paired page" at all) — set by 404.astro to skip hreflang
  // alternates entirely rather than emit a bogus /ja/404/ pair that 404s.
  noHreflang?: boolean;
}

const defaultDescription = "MDMC is an integrated design & digital strategy agency working across New Zealand, Australia and Japan.";
const { title, description = defaultDescription, active, locale, site = "co", lang, ogImage, noHreflang } = Astro.props;
const resolvedLocale = locale ?? (lang === "ja" ? "ja" : "en");
const { projects, articles } = await loadContent();

// EN-shaped path of the current page, regardless of which (site, lang) tree
// it's rendering as — the shape all alternates/canonicals are built from.
const enPath = enPathOf(site, resolvedLocale, Astro.url.pathname);

// Language decides the canonical domain (region duplicates consolidate by
// canonical only, per the 2026-08-21 matrix decision): every ja rendering
// canonicalizes to mdmc.co.jp, every en rendering to mdmc.co — so
// mdmc.co/ja/* points at co.jp/* and co.jp/en/* points at mdmc.co/*.
const enAlternateUrl = SITES.co + enPath;
const jaAlternateUrl = SITES.cojp + enPath;
const canonicalUrl = resolvedLocale === "ja" ? jaAlternateUrl : enAlternateUrl;

// Social share image. Project, article and job pages pass their own hero via
// the ogImage prop; every other page — home, work, news, about, careers,
// contact, 404 — had none at all, so sharing them anywhere rendered a bare
// text card.
//
// The fallback is the newest hero on the home slideshow, taken from
// heroSlidesOf() rather than re-deriving it: that is the same source of truth
// the hero itself uses (projects arrive sort=date:desc, and the helper keeps
// only those that actually have a hero_image), so the share card can never
// drift from what the slideshow shows. It follows the slideshow automatically
// as new work lands.
//
// Optional chaining throughout because it must degrade to no og:image rather
// than break a build: heroSlidesOf can legitimately return an empty array if
// no published project has a hero_image yet.
const heroFallback = heroSlidesOf(projects)[0]?.heroImage;
const resolvedOgImage = ogImage ?? heroFallback?.url;
// Only the fallback has a known alt. A page-supplied ogImage is just a URL,
// so there is nothing truthful to say about it.
const resolvedOgImageAlt = ogImage ? undefined : heroFallback?.alt || undefined;

// schema.org graph: one Organization plus one ProfessionalService per studio,
// so search engines read MDMC as a single business operating from
// Christchurch, North Sydney and Yokohama rather than three pages that happen
// to list addresses. Emitted site-wide from here for the same reason the
// favicon and og:image are — one wiring point covers all four trees.
const structuredData = jsonLd(
  organizationGraph({ origin: SITES[site], description, locale: resolvedLocale })
);

// NOTE for anyone editing the template below: `<html>` must be the FIRST
// thing after the frontmatter. Putting even a JSX comment ahead of it stops
// Astro recognising the document root, and it silently emits the page with no
// <html> or <head> wrapper at all — which costs `lang`, `data-site` and the
// document structure. Caught in the build output, 2026-09-09.
//
// data-site on <html> exposes the region axis to client scripts: the header
// derives region from localStorage, but an analytics event also needs to know
// which DOMAIN it fired on, because on co.jp the domain IS the region.
---

<!DOCTYPE html>
<html lang={resolvedLocale} data-site={site}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  {resolvedOgImage && <meta property="og:image" content={resolvedOgImage}>}
  {resolvedOgImageAlt && <meta property="og:image:alt" content={resolvedOgImageAlt}>}
  {/* Without this X renders og:image as a small square thumbnail; with it the
      hero gets the full-width card the artwork is cropped for. Harmless
      elsewhere — other platforms read the og: tags and ignore it. */}
  {resolvedOgImage && <meta name="twitter:card" content="summary_large_image">}
  <link rel="canonical" href={canonicalUrl}>
  {/* schema.org graph — see structured-data.js. is:inline keeps Astro from
      treating this as a component script; set:html emits the JSON verbatim
      rather than HTML-escaping the quotes into &quot;, which would make it
      unparseable. structured-data.js asserts the payload contains no
      </script sequence, the one real injection risk of inlining JSON-LD. */}
  <script type="application/ld+json" is:inline set:html={structuredData} />
  {!noHreflang && <link rel="alternate" hreflang="en" href={enAlternateUrl}>}
  {!noHreflang && <link rel="alternate" hreflang="ja" href={jaAlternateUrl}>}
  {!noHreflang && <link rel="alternate" hreflang="x-default" href={enAlternateUrl}>}
  <!-- Favicon set, generated by scripts/make-favicons.sh from the wordmark in
       design/brand/. This is the ONLY place it is wired: every page in all
       four trees (/, /ja/, /jp/, /en/) renders through this layout, and the
       ja-proxy Worker passes dotted root paths straight to the origin, so
       mdmc.co.jp picks the same files up. Every icon is a white square with
       black text in BOTH colour schemes — the SVG paints its own white
       background and carries no prefers-color-scheme rule, so it matches the
       .ico rather than inverting away from it. -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <!-- Matches --paper: the site has no dark theme, so this stays white in
       both schemes rather than fighting the page it frames. -->
  <meta name="theme-color" content="#ffffff">
  <!-- Preload the text faces so per-navigation paints never flash the
       fallback font (font-display: swap re-flows the header otherwise). -->
  <link rel="preload" href="/fonts/sohne-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/sohne-500.woff2" as="font" type="font/woff2" crossorigin>
  <title>{title}</title>
  <!-- Google Analytics 4 (gtag.js), one property across BOTH domains.
       Wired here for the same reason the favicon is: every page in all four
       trees renders through this layout, and the ja-proxy Worker passes the
       HTML through unchanged, so co.jp is measured by the same tag. Register
       mdmc.co.jp under this stream's "Configure your domains" in GA4 so a
       region hop stitches into one session instead of starting a second.

       `is:inline` is required. Without it Astro treats this as a component
       script — bundling, hoisting and rewriting it — and the tag stops being
       the tag Google expects.

       The official snippet is loaded via an allowlist rather than pasted
       verbatim, so localhost and any preview build neither load gtag nor
       report a hit. It sends nothing off the two real hostnames. The
       behaviour on those hostnames is identical to the pasted snippet:
       dataLayer, gtag('js', <date>), gtag('config', <id>). This is a static
       multi-page site, so each navigation is a real document load and fires
       its own page_view; there is no SPA route-change handling to add. -->
  <script is:inline>
    (function () {
      var ID = "G-9TWMV1SZMR";
      var HOSTS = ["mdmc.co", "www.mdmc.co", "mdmc.co.jp", "www.mdmc.co.jp"];
      if (HOSTS.indexOf(location.hostname) === -1) return;
      var s = document.createElement("script");
      s.async = true;
      s.src = "https://www.googletagmanager.com/gtag/js?id=" + ID;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag("js", new Date());
      gtag("config", ID);
    })();
  </script>
</head>
<body>
  <div class="zoom">
    <Header active={active} locale={resolvedLocale} site={site} enPath={enPath} projects={projects} articles={articles} />
    <slot />
    <Footer locale={resolvedLocale} site={site} />
  </div>
  <script>
    import { track, marketContext } from "../lib/analytics.js";

    // Fade the outgoing page's content before same-origin navigations, for
    // browsers WITHOUT cross-document View Transitions (those get the CSS
    // @view-transition crossfade in global.css instead). The incoming page's
    // own pageIn animation covers the fade-in half.
    const supportsVT = "startViewTransition" in document;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!supportsVT && !reduced) {
      document.addEventListener("click", (e) => {
        if (e.defaultPrevented || e.button !== 0) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const a = e.target instanceof Element ? e.target.closest("a[href]") : null;
        if (!a || a.target || a.hasAttribute("download")) return;
        const url = new URL(a.href, location.href);
        if (url.origin !== location.origin) return;
        // Same-page hash jumps (contact anchors) never fade.
        if (url.pathname === location.pathname && url.hash) return;
        e.preventDefault();
        document.documentElement.classList.add("page-leaving");
        setTimeout(() => location.assign(url.href), 190);
      });
    }
    // A bfcache restore brings the faded page back — always clear the state.
    addEventListener("pageshow", () => {
      document.documentElement.classList.remove("page-leaving");
    });

    // Secondary conversions: emailing or calling a studio directly. Plenty of
    // B2B enquiries never touch the form — the footer, the contact folds, the
    // JP About page and the careers page expose 285 mailto: and 93 tel: links
    // between them — so without this a paid click that converts by email
    // looks like a bounce.
    //
    // Delegated at the document so it covers every one of those links,
    // including the ones the mobile drawer renders, with no per-component
    // wiring. It only observes: no preventDefault, so the mail client or
    // dialler opens exactly as before, and track() swallows any failure.
    document.addEventListener("click", (e) => {
      const a = e.target instanceof Element ? e.target.closest('a[href^="mailto:"], a[href^="tel:"]') : null;
      if (!a) return;
      const href = a.getAttribute("href") || "";
      const isEmail = href.startsWith("mailto:");
      track("contact_click", {
        method: isEmail ? "email" : "phone",
        // A studio address or published office number — business contact
        // details, not the visitor's, so nothing personal is sent.
        target: href.replace(/^(mailto:|tel:)/, ""),
        ...marketContext(),
      });
    });
  </script>
</body>
</html>
