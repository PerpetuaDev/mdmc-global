---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { loadContent } from "../lib/content.js";

interface Props {
  title: string;
  description?: string;
  active?: "home" | "work" | "news" | "about" | "contact";
  lang?: string;
  ogImage?: string;
}

const defaultDescription = "MDMC is an integrated design & digital strategy agency working across New Zealand, Australia and Japan.";
const { title, description = defaultDescription, active, lang = "en", ogImage } = Astro.props;
const { projects, articles } = await loadContent();

// Construct canonical URL from site and pathname
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl.toString()}>
  {ogImage && <meta property="og:image" content={ogImage}>}
  <link rel="canonical" href={canonicalUrl.toString()}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <!-- Preload the text faces so per-navigation paints never flash the
       fallback font (font-display: swap re-flows the header otherwise). -->
  <link rel="preload" href="/fonts/sohne-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/sohne-500.woff2" as="font" type="font/woff2" crossorigin>
  <title>{title}</title>
</head>
<body>
  <div class="zoom">
    <Header active={active} projects={projects} articles={articles} />
    <slot />
    <Footer />
  </div>
  <script>
    // Fade the outgoing page's content before same-origin navigations, for
    // browsers WITHOUT cross-document View Transitions (those get the CSS
    // @view-transition crossfade in global.css instead). The incoming page's
    // own pageIn animation covers the fade-in half.
    const supportsVT = "startViewTransition" in document;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!supportsVT && !reduced) {
      document.addEventListener("click", (e) => {
        if (e.defaultPrevented || e.button !== 0) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const a = e.target instanceof Element ? e.target.closest("a[href]") : null;
        if (!a || a.target || a.hasAttribute("download")) return;
        const url = new URL(a.href, location.href);
        if (url.origin !== location.origin) return;
        // Same-page hash jumps (contact anchors) never fade.
        if (url.pathname === location.pathname && url.hash) return;
        e.preventDefault();
        document.documentElement.classList.add("page-leaving");
        setTimeout(() => location.assign(url.href), 190);
      });
    }
    // A bfcache restore brings the faded page back — always clear the state.
    addEventListener("pageshow", () => {
      document.documentElement.classList.remove("page-leaving");
    });
  </script>
</body>
</html>
