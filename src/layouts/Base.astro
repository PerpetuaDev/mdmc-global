---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { loadContent } from "../lib/content.js";

interface Props {
  title: string;
  description?: string;
  active?: "home" | "work" | "news" | "about" | "contact";
  lang?: string;
}

const defaultDescription = "MDMC is an integrated design & digital strategy agency working across New Zealand, Australia and Japan.";
const { title, description = defaultDescription, active, lang = "en" } = Astro.props;
const { projects, articles } = await loadContent();
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content={description}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <title>{title}</title>
</head>
<body>
  <div class="zoom">
    <Header active={active} projects={projects} articles={articles} />
    <slot />
    <Footer />
  </div>
</body>
</html>
