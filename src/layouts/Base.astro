---
import "../styles/global.css";
import Header from "../components/Header.astro";
import { loadContent } from "../lib/content.js";

interface Props {
  title: string;
  active?: "home" | "work" | "news" | "about" | "contact";
}

const { title, active } = Astro.props;
const { projects, articles } = await loadContent();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
</head>
<body>
  <div class="zoom">
    <Header active={active} projects={projects} articles={articles} />
    <slot />
  </div>
</body>
</html>
