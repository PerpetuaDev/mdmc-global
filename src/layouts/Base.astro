---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { loadContent } from "../lib/content.js";
import { counterpartPath, ORIGINS } from "../lib/i18n.js";

interface Props {
  title: string;
  description?: string;
  active?: "home" | "work" | "news" | "about" | "contact";
  locale?: "en" | "ja";
  // TEMPORARY back-compat: /ja/about/ still passes the old `lang` prop.
  // `locale` wins when both are given. A later task removes `lang` for good.
  lang?: string;
  ogImage?: string;
  // 404 has no ja counterpart (and no en counterpart either, really — it's
  // not a "paired page" at all) — set by 404.astro to skip hreflang
  // alternates entirely rather than emit a bogus /ja/404/ pair that 404s.
  noHreflang?: boolean;
}

const defaultDescription = "MDMC is an integrated design & digital strategy agency working across New Zealand, Australia and Japan.";
const { title, description = defaultDescription, active, locale, lang, ogImage, noHreflang } = Astro.props;
const resolvedLocale = locale ?? (lang === "ja" ? "ja" : "en");
const { projects, articles } = await loadContent();

// EN-shaped path of the current page, regardless of which locale it's
// rendering as — the shape linkHref/hreflang alternates are built from.
const enPath = resolvedLocale === "ja" ? counterpartPath("ja", Astro.url.pathname) : Astro.url.pathname;
const enAlternateUrl = new URL(enPath, Astro.site).toString();
const jaAlternateUrl = ORIGINS.ja ? ORIGINS.ja + enPath : new URL("/ja" + enPath, Astro.site).toString();

// Canonical follows the ja origin: with mdmc.co.jp live, ja pages' canonical
// is the co.jp URL (they're also reachable at mdmc.co/ja/* until the 301 —
// this consolidates indexing onto the ja domain).
const canonicalUrl =
  resolvedLocale === "ja" && ORIGINS.ja
    ? jaAlternateUrl
    : new URL(Astro.url.pathname, Astro.site).toString();
---

<!DOCTYPE html>
<html lang={resolvedLocale}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  {ogImage && <meta property="og:image" content={ogImage}>}
  <link rel="canonical" href={canonicalUrl}>
  {!noHreflang && <link rel="alternate" hreflang="en" href={enAlternateUrl}>}
  {!noHreflang && <link rel="alternate" hreflang="ja" href={jaAlternateUrl}>}
  {!noHreflang && <link rel="alternate" hreflang="x-default" href={enAlternateUrl}>}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <!-- Preload the text faces so per-navigation paints never flash the
       fallback font (font-display: swap re-flows the header otherwise). -->
  <link rel="preload" href="/fonts/sohne-400.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/sohne-500.woff2" as="font" type="font/woff2" crossorigin>
  <title>{title}</title>
</head>
<body>
  <div class="zoom">
    <Header active={active} locale={resolvedLocale} enPath={enPath} projects={projects} articles={articles} />
    <slot />
    <Footer locale={resolvedLocale} />
  </div>
  <script>
    // Fade the outgoing page's content before same-origin navigations, for
    // browsers WITHOUT cross-document View Transitions (those get the CSS
    // @view-transition crossfade in global.css instead). The incoming page's
    // own pageIn animation covers the fade-in half.
    const supportsVT = "startViewTransition" in document;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!supportsVT && !reduced) {
      document.addEventListener("click", (e) => {
        if (e.defaultPrevented || e.button !== 0) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const a = e.target instanceof Element ? e.target.closest("a[href]") : null;
        if (!a || a.target || a.hasAttribute("download")) return;
        const url = new URL(a.href, location.href);
        if (url.origin !== location.origin) return;
        // Same-page hash jumps (contact anchors) never fade.
        if (url.pathname === location.pathname && url.hash) return;
        e.preventDefault();
        document.documentElement.classList.add("page-leaving");
        setTimeout(() => location.assign(url.href), 190);
      });
    }
    // A bfcache restore brings the faded page back — always clear the state.
    addEventListener("pageshow", () => {
      document.documentElement.classList.remove("page-leaving");
    });
  </script>
</body>
</html>
