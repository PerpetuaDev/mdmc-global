---
// 404 — NOT in the design handoff (design/handoff/design/MDMC Site.dc.html
// has no not-found view); this is a new surface for the Astro rebuild,
// flagged for user review. Kept minimal and in the house voice: statement-
// scale headline (same clamp used on About's h1), one line of copy, a
// single .cta back to home. Same .gutter section rhythm and pageIn entrance
// as every other page.
import Base from "../layouts/Base.astro";
---

<Base title="Page not found — MDMC" noHreflang>
  <main style="animation: pageIn .6s var(--ease)">
    {/* Longhand paddings only — the `padding` shorthand would reset the
        left/right sides that .gutter provides. */}
    <section class="gutter" style="padding-top: 160px; padding-bottom: 200px;">
      <h1 style="font-size: clamp(48px, 5.6vw, 88px); font-weight: 500; letter-spacing: -0.025em; line-height: 1.02; text-wrap: balance; max-width: 1100px">
        Page not found.
      </h1>
      {/* Bilingual body: this one static 404.html also serves mdmc.co.jp
          (the Worker proxies origin 404s), so the JA line rides along under
          the EN one rather than maintaining a separate ja error page. */}
      <p style="margin-top: 32px; font-size: 20px; line-height: 1.5; max-width: 560px">
        The page you're looking for doesn't exist or has moved.<br />
        <span lang="ja">お探しのページは存在しないか、移動した可能性があります。</span>
      </p>
      <a href="/" class="cta" style="margin-top: 40px">
        Back to home <span class="arrow" aria-hidden="true">→</span>
      </a>
    </section>
  </main>
</Base>

<style>
  /* Responsive (2026-08-24, desktop-only handoff): phones step the 160/200px
     verticals down. Longhand padding-top/bottom only, like the inline styles
     they override (the `padding` shorthand would clobber .gutter's sides) —
     !important because inline style="" wins the cascade otherwise. */
  @media (max-width: 700px) {
    section.gutter { padding-top: 96px !important; padding-bottom: 120px !important; }
  }
</style>
