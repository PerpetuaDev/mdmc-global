---
// About EN — thin wrapper: loads content and renders AboutView inside Base.
// See AboutView.astro for the template itself (language-region-matrix
// extraction) and its header comment for prototype provenance notes.
import Base from "../../layouts/Base.astro";
import AboutView from "../../views/AboutView.astro";
import { loadContent } from "../../lib/content.js";
import { pageTitle } from "../../lib/i18n.js";

const { about } = await loadContent();

// Description for og:description: first paragraph of lede (for SEO) or default
const lede = about?.lede ?? "";
const description = lede ? lede.substring(0, 160) : undefined;
---

<Base title={pageTitle("co", "en", "About")} active="about" description={description}>
  <AboutView locale="en" site="co" about={about} />
</Base>
