---
// Job posting page — mdmc.co.jp/en tree (English on the Japan domain),
// served by the Worker at co.jp/en, canonical → mdmc.co. Identical to
// src/pages/careers/[slug].astro except site="cojp" passed to both Base and
// JobView (language-region matrix, 2026-08-21). NO `active` prop, same as
// the root wrapper. See careers/[slug].astro for the full header comment —
// unchanged here.
import Base from "../../../layouts/Base.astro";
import JobView from "../../../views/JobView.astro";
import { loadContent } from "../../../lib/content.js";

export async function getStaticPaths() {
  const { jobs } = await loadContent();
  return jobs.map((job) => ({
    params: { slug: job.slug },
    props: { job },
  }));
}

const { job } = Astro.props as {
  job: {
    slug: string;
    documentId: string;
    title: string;
    excerpt: string;
    body: string[];
    location: string;
    typeLabel: string;
    locationLabel?: string;
    applyEmail: string;
    heroImage: { url: string; alt: string } | null;
  };
};
const ogImage = job.heroImage?.url;
---

<Base title={`${job.title} — MDMC`} description={job.excerpt || undefined} ogImage={ogImage} locale="en" site="cojp">
  <JobView locale="en" site="cojp" job={job} />
</Base>
