---
import Base from "../layouts/Base.astro";
---

<Base title="MDMC">
  <main>
    <section class="gutter" style="padding-top: 64px; padding-bottom: 64px;">
      <p class="label" style="margin-bottom: 32px;">Design & Strategy</p>
      <h1 style="font-size: clamp(48px, 5.6vw, 88px); line-height: 1.02; letter-spacing: -0.025em; font-weight: 500; margin-bottom: 32px;">Make things people love to use.</h1>
      <p style="margin-bottom: 32px; max-width: 600px;">We are a boutique design studio based in Tokyo. We work with forward-thinking companies to create products and experiences that are beautiful, intuitive, and meaningful.</p>
      <a href="#" class="cta">
        Explore our work
        <span class="arrow">→</span>
      </a>
    </section>
  </main>
</Base>
