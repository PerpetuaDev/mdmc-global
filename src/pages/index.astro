---
// Home — transcribed from design/handoff/design/MDMC Site.dc.html lines
// 111-146 (hero slideshow -> statement -> work grid). The prototype's
// runtime (dc script ~line 805, 880-927) confirms: hero window = 4 newest
// projects, 6000ms auto-advance, workCols = 2, thumbRatio = 16 / 9.
//
// README lists a News strip for Home, but the prototype's actual home
// <main> (lines 111-146) is hero + statement + grid only, with no News
// section — matching the prototype here per source-of-truth precedence;
// flagging the README/prototype discrepancy at review.
import Base from "../layouts/Base.astro";
import WorkCard from "../components/WorkCard.astro";
import { loadContent } from "../lib/content.js";

const { projects } = await loadContent();
const heroSlides = projects.slice(0, 4);
const first = heroSlides[0];
---

<Base title="MDMC" active="home">
  <main style="animation: pageIn .6s var(--ease)">
    <section style="padding: 40px var(--gutter-r) 0 var(--gutter-l)">
      <div class="hero-frame">
        {heroSlides.map((p, i) => (
          <a
            href={`/work/${p.slug}/`}
            data-slide
            data-title={p.title}
            data-href={`/work/${p.slug}/`}
            aria-label={`Open ${p.title}`}
            aria-hidden={i === 0 ? "false" : "true"}
            tabindex="-1"
            class="hero-slide"
            style={`opacity: ${i === 0 ? "1" : "0"}; pointer-events: ${i === 0 ? "auto" : "none"}`}
          >
            {p.heroImage ? (
              <img src={p.heroImage.url} alt={p.heroImage.alt || p.title} />
            ) : (
              <div class="hero-placeholder" aria-hidden="true"></div>
            )}
          </a>
        ))}

        <div class="hero-overlay">
          <a
            href={first ? `/work/${first.slug}/` : "#"}
            data-hero-name
            style="pointer-events: auto; font-size: 20px; color: #000"
          >{first?.title}</a>
          <div role="group" aria-label="Browse featured projects" style="pointer-events: auto; display: inline-flex; align-items: center; gap: 12px; transform: translateY(5px)">
            <button type="button" data-hero-prev aria-label="Previous slide" class="hero-arrow hero-arrow-prev">←</button>
            <span aria-hidden="true" style="width: 2px; height: 18px; background: var(--faint); transform: translateY(1.5px)"></span>
            <button type="button" data-hero-next aria-label="Next slide" class="hero-arrow hero-arrow-next">→</button>
          </div>
        </div>
      </div>
    </section>

    <section style="padding: 143px var(--gutter-r) 168px calc(var(--gutter-l) + 150px); font-size: 32px; line-height: 1.4; letter-spacing: -0.005em">
      <div style="max-width: 880px">
        <p>We're MDMC—an integrated design &amp; <br>digital strategy agency.</p>
        <p style="margin-top: 1.5em">We help great products find the people <br>who'll love them, and help good, honest <br>businesses stand out from the noise.</p>
      </div>
    </section>

    <section style="padding: 0 var(--gutter-r) 160px var(--gutter-l)">
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); column-gap: 26px; row-gap: 64px">
        {projects.map((p) => <WorkCard project={p} />)}
      </div>
    </section>
  </main>
</Base>

<style>
  .hero-frame {
    position: relative;
    width: 100%;
    height: calc(100svh - 200px);
    min-height: 720px;
    background: var(--ph);
    overflow: hidden;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    display: block;
    transition: opacity 0.8s ease;
    background: var(--ph);
  }

  .hero-slide img,
  .hero-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    left: 32px;
    right: 32px;
    bottom: 24px;
    z-index: 2;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 32px;
    pointer-events: none;
  }

  .hero-arrow {
    font-size: 18px;
    line-height: 1;
    padding: 8px 4px;
    font-weight: 400;
    transition: transform 0.25s var(--ease);
  }
  .hero-arrow-prev:hover {
    transform: translateX(-4px);
  }
  .hero-arrow-next:hover {
    transform: translateX(4px);
  }
</style>

<script>
  const slides = [...document.querySelectorAll('[data-slide]')]
  const name = document.querySelector('[data-hero-name]')
  let i = 0
  function show(n) {
    i = (n + slides.length) % slides.length
    slides.forEach((s, j) => {
      const active = j === i
      s.style.opacity = active ? '1' : '0'
      s.style.pointerEvents = active ? 'auto' : 'none'
      s.setAttribute('aria-hidden', active ? 'false' : 'true')
    })
    if (name) {
      name.textContent = slides[i].dataset.title ?? ''
      name.href = slides[i].dataset.href ?? '#'
    }
  }
  document.querySelector('[data-hero-prev]')?.addEventListener('click', () => show(i - 1))
  document.querySelector('[data-hero-next]')?.addEventListener('click', () => show(i + 1))
  const auto = !matchMedia('(prefers-reduced-motion: reduce)').matches
  if (auto && slides.length > 1) setInterval(() => show(i + 1), 6000)
  if (slides.length) show(0)
</script>
