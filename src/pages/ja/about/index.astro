---
// About JP (ja) — thin wrapper: loads content and renders AboutJpView inside
// Base. See AboutJpView.astro for the template itself (language-region-matrix
// extraction) and its header comment for provenance notes (Strapi `aboutJapan`
// greeting band + hardcoded ABOUT_JP fact table / access blocks).
import Base from "../../../layouts/Base.astro";
import AboutJpView from "../../../views/AboutJpView.astro";
import { loadContent } from "../../../lib/content.js";

const { aboutJapan } = await loadContent();
---

<Base title="会社概要 — MDMC" active="about" locale="ja" description="MDMCはニュージーランド・オーストラリア・日本の3拠点で活動するデザイン&デジタル戦略ファームです。横浜スタジオの会社概要とアクセスのご案内。">
  <AboutJpView locale="ja" site="co" aboutJapan={aboutJapan} />
</Base>
