---
// Careers page (ja) — identical to src/pages/careers/index.astro except
// locale="ja" passed to both Base and CareersView (Phase-5 Task 4). `career`
// and `jobs` carry `.ja` overlays (machine-drafted placeholders, 2026-08-24)
// picked below via pickLocalized. See careers/index.astro for the full
// header comment.
import Base from "../../../layouts/Base.astro";
import CareersView from "../../../views/CareersView.astro";
import { pickLocalized } from "../../../lib/i18n.js";
import { loadContent } from "../../../lib/content.js";

const { career, jobs } = await loadContent();

const headline = (career && pickLocalized("ja", career, "headline")) || "Careers";
const intro = (career && pickLocalized("ja", career, "intro")) || [];
const heroImage = career?.heroImage;
const contactEmail = career?.contactEmail ?? "careers@mdmc.co";
---

{/* title is PLACEHOLDER JA (machine-drafted 2026-08-20, pending native review) */}
<Base title="採用情報 — MDMC" description={intro[0] || undefined} locale="ja">
  <CareersView locale="ja" headline={headline} intro={intro} heroImage={heroImage} contactEmail={contactEmail} jobs={jobs} />
</Base>
