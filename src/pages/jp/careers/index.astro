---
// Careers page — mdmc.co.jp (root) tree: built at origin /jp and served by
// the Worker at the co.jp root. Identical to src/pages/ja/careers/
// index.astro except site="cojp" passed to both Base and CareersView
// (language-region matrix, 2026-08-21). `career` and `jobs` have no `.ja`
// overlay (see CareersView.astro's header comment) — a deliberate,
// documented EN fallback. See careers/index.astro for the full header
// comment — unchanged here.
import Base from "../../../layouts/Base.astro";
import CareersView from "../../../views/CareersView.astro";
import { loadContent } from "../../../lib/content.js";

const { career, jobs } = await loadContent();

const headline = career?.headline ?? "Careers";
const intro = career?.intro ?? [];
const heroImage = career?.heroImage;
const contactEmail = career?.contactEmail ?? "careers@mdmc.co";
---

{/* title is PLACEHOLDER JA (machine-drafted 2026-08-20, pending native review) */}
<Base title="採用情報 — MDMC" description={intro[0] || undefined} locale="ja" site="cojp">
  <CareersView locale="ja" site="cojp" headline={headline} intro={intro} heroImage={heroImage} contactEmail={contactEmail} jobs={jobs} />
</Base>
