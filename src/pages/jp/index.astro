---
// Home — mdmc.co.jp (root) tree: built at origin /jp and served by the
// Worker at the co.jp root. Identical to src/pages/ja/index.astro except
// site="cojp" passed to both Base and HomeView (language-region matrix,
// 2026-08-21). See src/pages/index.astro for the full header comment (data
// loading, legacy-redirect map, provenance notes) — unchanged here.
import Base from "../../layouts/Base.astro";
import HomeView from "../../views/HomeView.astro";
import { loadContent } from "../../lib/content.js";
import { pageTitle } from "../../lib/i18n.js";

const { projects, articles, jobs } = await loadContent();

const redirectMap = {
  work: Object.fromEntries(projects.map((p) => [p.documentId, p.slug])),
  news: Object.fromEntries(articles.map((a) => [a.documentId, a.slug])),
  careers: Object.fromEntries(jobs.map((j) => [j.documentId, j.slug])),
};
---

{/* description is Claude-drafted JA (2026-09-09) — pending the native review pass */}
<Base title={pageTitle("cojp", "ja", "海外と日本をつなぐクリエイティブ")} active="home" locale="ja" site="cojp" description="横浜を拠点に、海外と日本をつなぐデザイン・デジタル戦略の統合エージェンシー。ブランドづくりからデジタルプラットフォームまで一貫してご支援します。">
  <!--
    Legacy hash-URL redirect shim — see src/pages/index.astro's identical
    comment for the full explanation; unchanged here, just locale="ja"
    site="cojp".
  -->
  <HomeView locale="ja" site="cojp" projects={projects} redirectMap={redirectMap} />
</Base>
