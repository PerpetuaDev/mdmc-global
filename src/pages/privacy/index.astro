---
// Privacy & Terms (New Zealand) — mdmc.co.
//
// EN-only by design. The document is written against the Privacy Act 2020,
// so it is NOT mirrored into /ja/ or /jp/: a Japanese policy has to be
// written against the APPI, and a translation of NZ law would be actively
// misleading. See PrivacyView.astro's header. co.jp needs its own document
// before Japanese ads run.
import Base from "../../layouts/Base.astro";
import PrivacyView from "../../views/PrivacyView.astro";
import { pageTitle } from "../../lib/i18n.js";
---

<Base
  title={pageTitle("co", "en", "Privacy & Terms")}
  description="How MDMC collects, uses and stores personal information, and the terms that apply to this site. Issued under the New Zealand Privacy Act 2020."
  noHreflang
>
  <PrivacyView locale="en" site="co" />
</Base>
