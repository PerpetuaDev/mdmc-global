---
// Project detail — header + Gallery view, transcribed from
// design/handoff/design/MDMC Site.dc.html lines 486-551 (README §6).
// Replaces the Phase-1 title+description stub. `data-view-pane="gallery"`
// wraps the gallery content so Task 5 can add a sibling
// `data-view-pane="story" hidden>` pane and wire the header toggle
// (ProjectHeader.astro renders `data-view-toggle` markup with no handler
// yet — see its header comment).
import Base from "../../layouts/Base.astro";
import ProjectHeader from "../../components/ProjectHeader.astro";
import GalleryStack from "../../components/GalleryStack.astro";
import { loadContent } from "../../lib/content.js";

export async function getStaticPaths() {
  const { projects } = await loadContent();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const hasStory = Boolean(project.story);
---

<Base title={project.title} active="work">
  <main style="animation: pageIn .6s var(--ease)">
    <ProjectHeader project={project} hasStory={hasStory} />
    <div data-view-pane="gallery">
      <GalleryStack
        gallery={project.gallery}
        heroImage={project.heroImage}
        pullQuote={project.pullQuote}
        pullQuoteAttribution={project.pullQuoteAttribution}
      />
    </div>
  </main>
</Base>
