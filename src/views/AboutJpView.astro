---
// About JP view — pure template, extracted from src/pages/ja/about/index.astro
// (language-region-matrix rollout). Data loading (loadContent) stays in the
// page wrappers; this component receives the raw `aboutJapan` object and
// derives hero/greeting/signature itself.
//
// Transcribed from design/handoff/design/MDMC Site.dc.html lines 243-302
// (full-width hero → ご挨拶 greeting band → 会社概要 fact table → アクセス).
// The greeting band consumes `aboutJapan` from Strapi (via loadContent() in
// the wrapper); the fact table and access blocks are NOT in Strapi — they
// come from src/lib/about-jp-data.js, built from the old site's real
// hardcoded JP strings (see that file's header comment for full provenance).
import { ABOUT_JP } from "../lib/about-jp-data.js";

interface Props {
  locale?: "en" | "ja";
  site?: "co" | "cojp";
  aboutJapan: any;
}

const { locale = "ja", site = "co", aboutJapan } = Astro.props as Props;

const heroImage = aboutJapan?.heroImage;
const greetingTitle = aboutJapan?.greetingTitle || "ご挨拶";
const greetingBody = aboutJapan?.greetingBody ?? [];
const signature = aboutJapan?.signature ?? { role: "", name: "", romaji: "", portrait: null };
---

<main style="animation: pageIn .6s var(--ease)">
  {/* Full-width hero */}
  {/* jp-hero / jp-greeting / jp-facts / jp-fact-row / jp-access /
      jp-access-grid: class hooks only (no desktop styles) — layout is
      inline style="" per the transcription, so the responsive <style> block
      below overrides it with !important (established pattern). */}
  <section class="jp-hero" style="padding: 80px var(--gutter-r) 0 var(--gutter-l)">
    <div style="width: 100%; aspect-ratio: 1853 / 812; background: var(--ph); overflow: hidden">
      {heroImage ? (
        <img src={heroImage.url} alt={heroImage.alt || "MDMC 横浜スタジオ"} style="width: 100%; height: 100%; object-fit: cover" />
      ) : (
        <div aria-hidden="true" style="width: 100%; height: 100%; background: var(--ph)"></div>
      )}
    </div>
  </section>

  {/* ご挨拶 greeting band */}
  <section class="jp-greeting" style="padding: 96px var(--gutter-r) 120px var(--gutter-l); border-bottom: 1px solid var(--hairline)">
    <div style="max-width: 820px">
      <h1 style="font-size: clamp(32px, 3.6vw, 48px); font-weight: 500; letter-spacing: -0.01em; line-height: 1.3; text-wrap: pretty">
        {greetingTitle}
      </h1>
      <div style="margin-top: 40px; font-size: 18px; line-height: 2">
        {greetingBody.map((para, i) => (
          <p style={i > 0 ? "margin-top: 1.5em" : undefined}>{para}</p>
        ))}
      </div>
      <div class="jp-signature" style="margin-top: 72px; display: grid; grid-template-columns: 96px 1fr; gap: 28px; align-items: center">
        <div style="width: 96px; height: 96px; border-radius: 50%; background: var(--ph); overflow: hidden">
          {signature.portrait ? (
            <img src={signature.portrait.url} alt={signature.portrait.alt || signature.name} style="width: 100%; height: 100%; object-fit: cover" />
          ) : (
            <div aria-hidden="true" style="width: 100%; height: 100%; background: var(--ph)"></div>
          )}
        </div>
        <div style="display: grid; gap: 4px">
          <div style="font-size: 13px; color: var(--muted)">{signature.role}</div>
          <div class="jp-sig-name" style="font-size: 22px; font-weight: 500; letter-spacing: 0.01em">{signature.name}</div>
          <div style="font-size: var(--label); letter-spacing: .12em; text-transform: uppercase; color: var(--muted)">{signature.romaji}</div>
        </div>
      </div>
    </div>
  </section>

  {/* 会社概要 fact table */}
  <section class="jp-facts" style="padding: 96px var(--gutter-r) 96px var(--gutter-l); border-bottom: 1px solid var(--hairline)">
    <h2 style="font-size: clamp(36px, 4vw, 56px); font-weight: 500; letter-spacing: -0.01em; margin-bottom: 56px">会社概要</h2>
    <dl style="margin: 0; border-top: 1px solid var(--hairline)">
      {ABOUT_JP.facts.map((fact) => (
        <div class="jp-fact-row" style="display: grid; grid-template-columns: 200px 1fr; gap: 48px; padding: 24px 0; border-bottom: 1px solid var(--hairline); align-items: baseline">
          <dt style="font-size: var(--text-s); color: var(--muted)">{fact.dt}</dt>
          <dd style="margin: 0; font-size: 17px; line-height: 1.7">
            {fact.dd.map((line, i) => (
              <>
                {line}
                {i < fact.dd.length - 1 && <br />}
              </>
            ))}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  {/* アクセス */}
  <section class="jp-access" style="padding: 96px var(--gutter-r) 160px var(--gutter-l)">
    <h2 style="font-size: clamp(36px, 4vw, 56px); font-weight: 500; letter-spacing: -0.01em; margin-bottom: 56px">アクセス</h2>
    <div class="jp-access-grid" style="display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 48px; align-items: start">
      {/* 横浜スタジオ（Nisankai）の写真 — decorative, the access facts beside
          it carry the information (same self-hosted asset the footer uses). */}
      <img src="/images/studios/jp.webp" alt="" loading="lazy" decoding="async" style="width: 100%; aspect-ratio: 4 / 3; background: var(--ph); overflow: hidden; object-fit: cover; display: block" />
      <div style="display: grid; gap: 32px">
        {ABOUT_JP.access.map((block) => (
          <div style="border-top: 1px solid var(--hairline); padding-top: 20px">
            <div style="font-size: var(--label); letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px">{block.title}</div>
            <div style="font-size: 17px; line-height: 1.7">
              {block.lines.map((line, i) => (
                line.includes("@") ? (
                  <a class="jp-mail-link" href={`mailto:${line}`}>{line}</a>
                ) : (
                  <>
                    {line}
                    {i < block.lines.length - 1 && <br />}
                  </>
                )
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</main>

<style>
  /* Responsive (2026-08-24, desktop-only handoff): phones stack the 会社概要
     fact rows (dt above dd) and the アクセス 1.4fr/1fr grid (photo first),
     and step the 96–160px section rhythm down. Layout is inline style="" on
     the elements (transcription), hence !important. CJK strings don't
     hyphen-break, so the stacked tracks stay minmax(0, 1fr). */
  @media (max-width: 700px) {
    .jp-hero { padding-top: 64px !important; }
    .jp-greeting { padding-top: 64px !important; padding-bottom: 80px !important; }
    .jp-facts { padding-top: 64px !important; padding-bottom: 64px !important; }
    .jp-facts h2, .jp-access h2 { margin-bottom: 40px !important; }
    .jp-fact-row { grid-template-columns: minmax(0, 1fr) !important; gap: 8px !important; padding: 20px 0 !important; }
    /* A 390px viewport leaves the name column ~218px next to the 96px
       portrait — フィンレイソン・リアム (10 chars at 22px) broke one
       character onto its own line; the smaller portrait keeps it whole. */
    .jp-signature { grid-template-columns: 72px minmax(0, 1fr) !important; gap: 20px !important; margin-top: 56px !important; }
    .jp-signature > div:first-child { width: 72px !important; height: 72px !important; }
    .jp-sig-name { font-size: 19px !important; }
    .jp-access { padding-top: 64px !important; padding-bottom: 96px !important; }
    .jp-access-grid { grid-template-columns: minmax(0, 1fr) !important; gap: 40px !important; }
  }

  .jp-mail-link {
    display: inline-block;
    transition: box-shadow 0.2s ease;
  }
  .jp-mail-link:hover {
    box-shadow: inset 0 -1px 0 currentColor;
  }
</style>
