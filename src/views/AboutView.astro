---
// About EN view — pure template, extracted from src/pages/about/index.astro
// (language-region-matrix rollout). Data loading (loadContent) stays in the
// page wrappers; this component receives the raw `about` object and derives
// headline/lede/heroImage/sections itself.
//
// Transcribed from design/handoff/design/MDMC Site.dc.html lines 193–240
// (statement headline → hero → lede → four key-value sections → three-up
// studio strip). Sections are only rendered when populated (kv_* title
// exists); studio photos are grey placeholders until content arrives.
//
// The studio strip uses studiosForSite(site) — region-ordered: mdmc.co.jp
// leads with the Japan studio, mdmc.co keeps the canonical NZ/AU/JP order.
import { studiosForSite } from "../lib/studios.js";

interface Props {
  locale?: "en" | "ja";
  site?: "co" | "cojp";
  about: any;
}

const { locale = "en", site = "co", about } = Astro.props as Props;

// Fallback for null about: headline → "About", lede → null (uses default)
const headline = about?.headline ?? "About";
const lede = about?.lede ?? "";
const heroImage = about?.heroImage;
const sections = about?.sections ?? [];

const studios = studiosForSite(site);
---

<main style="animation: pageIn .6s var(--ease)">
  {/* Statement headline + full-width hero */}
  {/* about-hero / about-lede / about-kv / about-studios / studio-strip:
      class hooks only (no desktop styles) — the layout is inline style=""
      per the transcription, so the responsive <style> block below overrides
      it with !important (established pattern, see Header.astro). */}
  <section class="about-hero" style="padding: 80px var(--gutter-r) 0 var(--gutter-l)">
    <h1 style="font-size: clamp(48px, 5.6vw, 88px); font-weight: 500; letter-spacing: -0.025em; line-height: 1.02; text-wrap: balance; max-width: 1100px">
      {headline}
    </h1>
    <div style="margin-top: 80px; width: 100%; aspect-ratio: 1853 / 812; background: var(--ph); overflow: hidden">
      {heroImage ? (
        <img src={heroImage.url} alt={heroImage.alt || "About MDMC"} style="width: 100%; height: 100%; object-fit: cover" />
      ) : (
        <div aria-hidden="true" style="width: 100%; height: 100%; background: var(--ph)"></div>
      )}
    </div>
  </section>

  {/* Lede section with label grid */}
  {lede && (
    <section class="about-lede" style="padding: 96px var(--gutter-r) 0 var(--gutter-l); display: grid; grid-template-columns: 240px minmax(0, 720px); gap: 48px">
      <h2 class="label" style="padding-top: 10px">About</h2>
      <p style="font-size: 26px; line-height: 1.45; letter-spacing: -0.01em">
        {lede}
      </p>
    </section>
  )}

  {/* Four key-value sections with label grid (only if title exists) */}
  {sections.length > 0 && (
    <section class="about-kv" style="padding: 144px var(--gutter-r) 0 var(--gutter-l); display: grid; grid-template-columns: 240px minmax(0, 720px); gap: 96px 48px">
      {sections.map((section) => (
        <>
          <h2 class="label" style="padding-top: 6px">
            {section.title}
          </h2>
          <div>
            {section.body.map((para) => (
              <p style="font-size: 20px; line-height: 1.6; margin: 0">
                {para}
              </p>
            ))}
          </div>
        </>
      ))}
    </section>
  )}

  {/* Three-up studio strip */}
  <section class="about-studios" style="padding: 160px var(--gutter-r) 160px var(--gutter-l)">
    <div class="studio-strip" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px">
      {studios.map((studio) => (
        <div>
          <div style="width: 100%; aspect-ratio: 4 / 3; background: var(--ph); overflow: hidden">
            {/* studio.image is a self-hosted path string (see studios.js);
                decorative — the region label + address below carry the info. */}
            {studio.image ? (
              <img src={studio.image} alt="" loading="lazy" decoding="async" style="width: 100%; height: 100%; object-fit: cover" />
            ) : (
              <div aria-hidden="true" style="width: 100%; height: 100%; background: var(--ph)"></div>
            )}
          </div>
          <div class="label" style="margin-top: 20px">
            {studio.region}
          </div>
          <div style="margin-top: 10px; font-size: 18px; line-height: 1.5">
            {studio.addressLines.map((line, i) => (
              <>
                {line}
                {i < studio.addressLines.length - 1 && <br />}
              </>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</main>

<style>
  /* Responsive (2026-08-24, desktop-only handoff): tablet keeps the 3-up
     studio strip (it fits at 768 with the clamped gutters, just a tighter
     gap); phones stack the 240px label grids (label above content) and the
     studio strip, and step the 96–160px section rhythm down. Layout is
     inline style="" on the elements (transcription), hence !important. */
  @media (max-width: 1023px) {
    .studio-strip { gap: 20px !important; }
  }
  @media (max-width: 700px) {
    .about-hero { padding-top: 64px !important; }
    .about-hero > div { margin-top: 48px !important; }
    .about-lede { grid-template-columns: minmax(0, 1fr) !important; gap: 16px !important; padding-top: 64px !important; }
    .about-lede p { font-size: 22px !important; }
    .about-kv { grid-template-columns: minmax(0, 1fr) !important; gap: 16px !important; padding-top: 96px !important; }
    /* Group separation: stacked, the uniform grid gap can't distinguish
       label→body (tight) from body→next label (loose) — the body div
       carries the extra air instead. */
    .about-kv > div:not(:last-child) { margin-bottom: 48px; }
    .about-studios { padding-top: 96px !important; padding-bottom: 96px !important; }
    .studio-strip { grid-template-columns: minmax(0, 1fr) !important; row-gap: 48px !important; }
  }
</style>
