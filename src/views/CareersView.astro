---
// Careers view — pure template, extracted from src/pages/careers/index.astro
// (Phase-5 Task 4). Data loading (loadContent) stays in the page wrapper;
// this component receives `headline`, `intro`, `heroImage`, `contactEmail`,
// and `jobs` as props.
//
// See src/pages/careers/index.astro's original header comment for provenance
// notes (design/handoff/design/MDMC Site.dc.html lines 305-331).
//
// `career` (headline/intro/heroImage) is fetched EN-only by content.js (no
// `.ja` overlay exists — see content.js's _load, which never requests
// `/career?...&locale=ja`), so ja pages render the same English headline/
// intro/hero as en — a deliberate, documented EN fallback, not a bug. Same
// for `jobs` (normalizeJob has no `.ja` overlay either): job titles/locale/
// type render in English on ja pages too.
import { makeT, makeLinks, pickLocalized } from "../lib/i18n.js";

interface Props {
  locale?: "en" | "ja";
  site?: "co" | "cojp";
  headline: string;
  intro: string[];
  heroImage: { url: string; alt: string } | null;
  contactEmail: string;
  jobs: any[];
}

const { locale = "en", site = "co", headline, intro, heroImage, contactEmail, jobs } = Astro.props as Props;
const links = makeLinks(site, locale);
const t = makeT(locale);
---

<main style="animation: pageIn .6s var(--ease)">
  {/* Statement headline + full-width hero */}
  {/* careers-hero / careers-intro / careers-positions / job-row / job-arrow:
      class hooks only (no desktop styles) — layout is inline style="" per
      the transcription, so the responsive <style> block below overrides it
      with !important (established pattern). */}
  <section class="careers-hero" style="padding: 80px var(--gutter-r) 0 var(--gutter-l)">
    <h1 style="font-size: clamp(48px, 5.6vw, 88px); font-weight: 500; letter-spacing: -0.025em; line-height: 1.02; text-wrap: balance; max-width: 1100px">
      {headline}
    </h1>
    <div style="margin-top: 80px; width: 100%; aspect-ratio: 1853 / 812; background: var(--ph); overflow: hidden">
      {heroImage ? (
        <img src={heroImage.url} alt={heroImage.alt || `MDMC ${t("careers.title")}`} style="width: 100%; height: 100%; object-fit: cover" />
      ) : (
        <div aria-hidden="true" style="width: 100%; height: 100%; background: var(--ph)"></div>
      )}
    </div>
  </section>

  {/* Careers intro section with label grid */}
  {intro.length > 0 && (
    <section class="careers-intro" style="padding: 96px var(--gutter-r) 0 var(--gutter-l); display: grid; grid-template-columns: 240px minmax(0, 720px); gap: 48px">
      <h2 class="label" style="padding-top: 10px">{t("careers.title")}</h2>
      <div>
        {intro.map((para) => (
          <p style="font-size: 26px; line-height: 1.45; letter-spacing: -0.01em; margin: 0">
            {para}
          </p>
        ))}
      </div>
    </section>
  )}

  {/* Open positions section */}
  <section class="careers-positions" style="padding: 144px var(--gutter-r) 64px var(--gutter-l)">
    <h2 class="label" style="margin-bottom: 40px">{t("careers.openPositions")}</h2>
    <ul style="list-style: none; margin: 0; padding: 0">
      {jobs.map((job) => (
        <li>
          <a class="job-row" href={links.internal(`/careers/${job.slug}/`)} style="display: grid; grid-template-columns: minmax(0, 420px) 200px 160px 1fr; gap: 48px; align-items: center; padding: 28px 0; border-top: 1px solid rgba(0,0,0,0.12); border-bottom: 1px solid rgba(0,0,0,0.12); text-decoration: none; color: inherit; transition: opacity 0.2s ease">
            <h3 style="font-size: var(--text-l); font-weight: 500; letter-spacing: -0.005em; margin: 0">
              {pickLocalized(locale, job, "title")}
            </h3>
            <div>
              <div class="label">{t("careers.meta.studio")}</div>
              <div style="margin-top: 6px; font-size: 17px">
                {locale === "ja" ? (job.locationLabelJa ?? job.locationLabel) : job.locationLabel}
              </div>
            </div>
            <div>
              <div class="label">{t("careers.meta.type")}</div>
              <div style="margin-top: 6px; font-size: 17px">
                {locale === "ja" ? (job.typeLabelJa ?? job.typeLabel) : job.typeLabel}
              </div>
            </div>
            <span class="job-arrow" aria-hidden="true" style="justify-self: end; font-family: 'Söhne', 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 400; font-size: var(--text)">→</span>
          </a>
        </li>
      ))}
    </ul>

    {/* CTA to contact */}
    <a href={`mailto:${contactEmail}`} class="cta" style="margin-top: 88px">{t("careers.speculativeCta")}
      <span style="font-family: 'Söhne', 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 400">→</span>
    </a>
  </section>
</main>

<style>
  /* Responsive (2026-08-24, desktop-only handoff): the fixed job-row
     columns (420px/200px/160px + 48px gaps ≈ 924px) don't fit tablets —
     tablet keeps one row with narrower tracks; phones give the title its
     own full row with studio/type side by side beneath and drop the arrow.
     Layout is inline style="" on the elements, hence !important. */
  @media (max-width: 1023px) {
    .job-row { grid-template-columns: minmax(0, 1fr) 150px 130px 24px !important; gap: 24px !important; }
  }
  @media (max-width: 700px) {
    .careers-hero { padding-top: var(--sp-6) !important; }
    .careers-hero > div { margin-top: var(--sp-5) !important; }
    .careers-intro { grid-template-columns: minmax(0, 1fr) !important; gap: 16px !important; padding-top: var(--sp-6) !important; }
    .careers-intro p { font-size: 22px !important; }
    .careers-positions { padding-top: var(--sp-7) !important; }
    .job-row { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 16px 24px !important; padding: 24px 0 !important; }
    .job-row h3 { grid-column: 1 / -1; }
    .job-arrow { display: none; }
    .careers-positions a[href^="mailto:"] { margin-top: var(--sp-5) !important; }
  }

  a[href^="/careers/"]:hover {
    opacity: 0.6;
  }

  a[href^="mailto:"]:hover {
    border-bottom-color: currentColor;
  }
</style>
