---
// Home view — pure template, extracted from src/pages/index.astro (Phase-5
// Task 3). Data loading (loadContent) stays in the page wrapper; this
// component receives `projects` + the build-time `redirectMap` for the
// legacy-redirect shim as props and derives everything else (heroSlides,
// first) from `projects`.
//
// See src/pages/index.astro's original header comment for provenance notes
// (design/handoff/design/MDMC Site.dc.html lines 111-146; hero window = 4
// newest projects WITH a hero image — see heroSlidesOf in content.js —
// 6000ms auto-advance, workCols = 2, thumbRatio = 16 / 9).
import WorkCard from "../components/WorkCard.astro";
import { makeT, pickLocalized, makeLinks, interpolate } from "../lib/i18n.js";
import { thumbSlidesOf } from "../lib/content.js";
import { unwrapAuthoredBreaks } from "../lib/text.js";

interface Props {
  locale?: "en" | "ja";
  site?: "co" | "cojp";
  projects: any[];
  redirectMap: Record<string, Record<string, string>>;
}

const { locale = "en", site = "co", projects, redirectMap } = Astro.props as Props;
const links = makeLinks(site, locale);
const t = makeT(locale);
// Below 1024 the slideshow runs on 4:3 thumbnails, so ALL six projects are
// eligible; at >=1024 the three without hero art are hidden by CSS, leaving
// the same three heroSlidesOf() used to allow. One <picture> per slide means
// the browser downloads one image, not both. Slide 0 (zenrise-website) has
// hero art, so the server-rendered initial slide is correct at both widths.
const thumbSlides = thumbSlidesOf(projects);
const first = thumbSlides[0];

// home.manifesto.1/2 store their line breaks as literal '\n'; split into
// segments rendered around literal <br> tags below (see i18n.js). Each
// segment goes through a `<Fragment set:html>` rather than a plain `{}`
// text expression: the dict values are plain EN prose text (an apostrophe
// in "who'll", a raw "&" manually re-escaped to "&amp;" here since set:html
// skips Astro's own escaping), and a `{}` expression would HTML-escape the
// apostrophe to `&#39;`, which the prototype's literal (unescaped) markup
// never did. The <br> tags stay literal JSX elements (not part of any
// set:html blob) so they still pick up Astro's scoped-style attribute like
// every other element on this page.
const escAmp = (s: string) => s.replace(/&/g, "&amp;");
const manifesto1 = t("home.manifesto.1").split("\n").map(escAmp);
const manifesto2 = t("home.manifesto.2").split("\n").map(escAmp);
// Below 1024 those authored breaks orphan their last word at a narrow measure
// ("people", "honest", "noise."), so the same copy is also emitted as flowing
// paragraphs and the two are swapped by media query. Both are in the DOM and
// only one is shown: two short paragraphs of duplicated bytes is negligible,
// and a CSS swap stays correct with JS disabled and across resizes.
const manifesto1Flow = escAmp(unwrapAuthoredBreaks(t("home.manifesto.1")));
const manifesto2Flow = escAmp(unwrapAuthoredBreaks(t("home.manifesto.2")));

// Legacy hash-URL redirect shim: the `script is:inline
// define:vars={{ redirectMap }}` immediately below — see
// src/pages/index.astro's comment above <HomeView /> for the full
// explanation (canonical impl in src/lib/legacy-redirects.js, and why that
// doc comment lives one level up rather than here).
---

<script is:inline define:vars={{ redirectMap }}>
    if (location.hash) {
      const legacyRedirect = (hash, map) => {
        const h = hash.replace(/^#\/?/, '')
        if (!h) return null
        const parts = h.split('/')
        const section = parts[0]
        const id = parts[1]
        if (section === 'work' || section === 'news' || section === 'careers') {
          if (id) {
            const slug = map[section] && map[section][id]
            return slug ? `/${section}/${slug}/` : `/${section}/`
          }
          return `/${section}/`
        }
        if (['about', 'contact'].includes(section)) return `/${section}/`
        return null
      }
      const target = legacyRedirect(location.hash, redirectMap)
      if (target) location.replace(target)
    }
  </script>

<main style="animation: pageIn .6s var(--ease)">
  <section style="padding: 40px var(--gutter-r) 0 var(--gutter-l)">
    <div class="hero-frame">
      {thumbSlides.map((p, i) => (
        <a
          href={links.internal(`/work/${p.slug}/`)}
          data-slide
          data-title={pickLocalized(locale, p, "title")}
          data-href={links.internal(`/work/${p.slug}/`)}
          aria-label={interpolate(t("a11y.openProject"), { title: pickLocalized(locale, p, "title") })}
          aria-hidden={i === 0 ? "false" : "true"}
          tabindex="-1"
          class:list={["hero-slide", { "is-thumb-only": !p.heroImage }]}
          style={`opacity: ${i === 0 ? "1" : "0"}; pointer-events: ${i === 0 ? "auto" : "none"}`}
        >
          {p.thumbnail ? (
            <picture>
              {p.heroImage && <source media="(min-width: 1024px)" srcset={p.heroImage.url} />}
              <img src={p.thumbnail.url} alt={p.thumbnail.alt || pickLocalized(locale, p, "title")} />
            </picture>
          ) : (
            <div class="hero-placeholder" aria-hidden="true"></div>
          )}
        </a>
      ))}

      <div class="hero-overlay">
        <a
          href={first ? links.internal(`/work/${first.slug}/`) : "#"}
          data-hero-name
          style="pointer-events: auto; font-size: var(--text); color: #000"
        >{first ? pickLocalized(locale, first, "title") : undefined}</a>
        <div role="group" aria-label={t("a11y.browseProjects")} style="pointer-events: auto; display: inline-flex; align-items: center; gap: 12px; transform: translateY(5px)">
          <button type="button" data-hero-prev aria-label={t("a11y.prevSlide")} class="hero-arrow hero-arrow-prev">←</button>
          <span aria-hidden="true" style="width: 2px; height: 18px; background: var(--faint); transform: translateY(1.5px)"></span>
          <button type="button" data-hero-next aria-label={t("a11y.nextSlide")} class="hero-arrow hero-arrow-next">→</button>
        </div>
      </div>
    </div>
  </section>

  <section class="home-manifesto" style="padding: 143px var(--gutter-r) 168px calc(var(--gutter-l) + 150px); font-size: 32px; line-height: 1.4; letter-spacing: -0.005em">
    <div style="max-width: 880px">
      <div class="manifesto-lined">
        <p><Fragment set:html={manifesto1[0]} /> <br><Fragment set:html={manifesto1[1]} /></p>
        <p style="margin-top: 1.5em"><Fragment set:html={manifesto2[0]} /> <br><Fragment set:html={manifesto2[1]} /> <br><Fragment set:html={manifesto2[2]} /></p>
      </div>
      <div class="manifesto-flow">
        <p><Fragment set:html={manifesto1Flow} /></p>
        <p style="margin-top: 1.5em"><Fragment set:html={manifesto2Flow} /></p>
      </div>
    </div>
  </section>

  <section class="home-workgrid" style="padding: 0 var(--gutter-r) 160px var(--gutter-l)">
    <div style="display: grid; grid-template-columns: repeat(2, 1fr); column-gap: 26px; row-gap: 64px">
      {projects.map((p) => <WorkCard project={p} locale={locale} site={site} />)}
    </div>
  </section>
</main>
<style>
  /* Responsive (2026-08-24): the desktop fold rule (viewport-matching hero)
     is a desktop composition — tablets keep a shorter formula, phones use a
     fixed-ratio hero. Manifesto loses its 150px indent and steps down; the
     work grid goes single-column on phones. */
  /* Touch floor (2026-09-03): the hero arrows were 21x34 and the project
     title link 22px tall. The overlay is absolutely positioned, so growing
     these does not move the frame. */
  /* Desktop keeps the authored line breaks; below 1024 the flowing copy
     takes over. See the note beside manifesto1Flow in the frontmatter. */
  @media (min-width: 1024px) {
    /* Desktop keeps the hero-art-only set — heroSlidesOf()'s guard, now
       expressed in CSS because the DOM carries the wider thumbnail set.
       display:none (not opacity) so the cycling script can count it. */
    .hero-slide.is-thumb-only { display: none; }
  }

  @media (max-width: 1023px) {
    .hero-frame {
      /* The desktop fold rule (100svh/--page-zoom - 266.7px) encodes desktop
         header metrics and is meaningless against a narrow header, so the
         frame is a fixed 16:9 box. sizeHero() is guarded to match.

         16:9 is chosen from the assets as they actually are, measured
         2026-09-03: the six thumbnails run 1.33, 1.50, 2.17 (x3) and 2.66,
         so NO fixed ratio is crop-free — the spec's "all 4:3" premise was
         wrong. At 16:9 the worst case shows 67% of an image and the dominant
         2.17 screenshots show 82%, against 27% for the portrait box this
         replaces. A fixed ratio also keeps the frame height stable, so the
         page does not reflow as slides rotate. */
      height: auto !important;
      min-height: 0 !important;
      aspect-ratio: 16 / 9;
    }
    /* The overlay is currentColor/#000 over arbitrary project imagery, so on
       a dark thumbnail the title and arrows disappeared entirely (the left
       arrow was invisible against the Youki photo). A soft scrim restores
       contrast without changing the type. Desktop has the same latent issue
       but is out of scope for this pass — reported, not silently changed. */
    .hero-frame::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 45%;
      background: linear-gradient(to top, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0));
      pointer-events: none;
      z-index: 1;
    }
  }

  .manifesto-flow { display: none; }
  @media (max-width: 1023px) {
    .manifesto-lined { display: none; }
    .manifesto-flow { display: block; }
  }

  @media (max-width: 1023px) {
    .hero-overlay a {
      min-height: var(--tap);
      display: inline-flex;
      align-items: center;
    }
    .hero-arrow {
      min-width: var(--tap);
      min-height: var(--tap);
      display: inline-flex !important;
      align-items: center;
      justify-content: center;
    }
  }

  @media (max-width: 1023px) {
    /* !important also on the scoped-class overrides: this block sits above
       the base rules in source order, and equal-specificity scoped rules
       later in the sheet would otherwise win the cascade. */
    /* The old tablet floor (min-height: 480px !important) is gone: it sat
       later in source than the 16:9 block above with equal specificity, so it
       won the cascade and pinned the frame to 480px tall — which is why the
       frame measured 332x480 (0.69) at 390 instead of 16:9. The aspect-ratio
       governs the frame's height at every width below 1024 now. */
    .home-manifesto { padding: 104px var(--gutter-r) 120px var(--gutter-l) !important; font-size: 26px !important; }
  }
  @media (max-width: 700px) {
    /* .hero-frame sizing lives in the max-width:1023px block above — a
       62svh height here (!important, and later in source) overrode it and
       kept the frame portrait at 390px. */
    .home-manifesto { padding: 80px var(--gutter-r) 96px var(--gutter-l) !important; font-size: 21px !important; }
    .home-workgrid > div { grid-template-columns: 1fr !important; row-gap: var(--sp-5) !important; }
    .hero-overlay { left: 16px !important; right: 16px !important; bottom: 14px !important; }
  }

  .hero-frame {
    position: relative;
    width: 100%;
    /* Fold rule: the gap below the image (to the viewport bottom) must equal
       the gap above it (logo bottom → image top). 100svh is scaled by the
       .zoom wrapper, so /--page-zoom restores the real viewport; 266.7px =
       image top (181.1: header 64 + logo row + 36, plus this section's 40
       top padding) + the mirrored 85.6 logo gap, in CSS px. The hero script
       re-measures on load/resize so the equality stays exact if header
       metrics ever drift. */
    height: calc(100svh / var(--page-zoom) - 266.7px);
    min-height: 720px;
    background: var(--ph);
    overflow: hidden;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    display: block;
    transition: opacity 0.8s ease;
    background: var(--ph);
  }

  .hero-slide img,
  .hero-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    left: 32px;
    right: 32px;
    bottom: 24px;
    z-index: 2;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 32px;
    pointer-events: none;
  }

  .hero-arrow {
    font-size: 18px;
    line-height: 1;
    padding: 8px 4px;
    font-weight: 400;
    transition: transform 0.25s var(--ease);
  }
  .hero-arrow-prev:hover {
    transform: translateX(-4px);
  }
  .hero-arrow-next:hover {
    transform: translateX(4px);
  }
</style>
<script>
  // The DOM carries the mobile slide set (every project with a thumbnail);
  // at >=1024 CSS hides the ones without hero art. So the cycle must run over
  // VISIBLE slides and be rebuilt whenever a resize crosses that boundary —
  // counting all of them would fade to a display:none slide for six seconds.
  const allSlides = [...document.querySelectorAll('[data-slide]')]
  const name = document.querySelector('[data-hero-name]')
  let slides = []
  let i = 0
  let timer = null

  const visibleSlides = () => allSlides.filter((s) => getComputedStyle(s).display !== 'none')

  function show(n) {
    if (!slides.length) return
    i = (n + slides.length) % slides.length
    // Reset every slide, not just the visible set: one hidden at this width
    // may still carry opacity:1 from the other side of the boundary.
    allSlides.forEach((s) => {
      s.style.opacity = '0'
      s.style.pointerEvents = 'none'
      s.setAttribute('aria-hidden', 'true')
    })
    const active = slides[i]
    active.style.opacity = '1'
    active.style.pointerEvents = 'auto'
    active.setAttribute('aria-hidden', 'false')
    if (name) {
      name.textContent = active.dataset.title ?? ''
      name.href = active.dataset.href ?? '#'
    }
  }

  function rebuild() {
    const next = visibleSlides()
    const countChanged = next.length !== slides.length
    slides = next
    if (countChanged || i >= slides.length) i = 0
    if (slides.length) show(i)
    if (timer) clearInterval(timer)
    const auto = !matchMedia('(prefers-reduced-motion: reduce)').matches
    if (auto && slides.length > 1) timer = setInterval(() => show(i + 1), 6000)
  }

  // A manual advance restarts the timer so the slide does not jump again a
  // moment later.
  function step(delta) {
    show(i + delta)
    if (timer) clearInterval(timer)
    const auto = !matchMedia('(prefers-reduced-motion: reduce)').matches
    if (auto && slides.length > 1) timer = setInterval(() => show(i + 1), 6000)
  }

  document.querySelector('[data-hero-prev]')?.addEventListener('click', () => step(-1))
  document.querySelector('[data-hero-next]')?.addEventListener('click', () => step(1))
  rebuild()
  addEventListener('resize', rebuild)

  // Fold rule: gap below the image (to viewport bottom) === gap above it
  // (logo bottom -> image top). The CSS calc already lands within a pixel;
  // this re-derives the height from real layout so the equality is exact at
  // any viewport, browser, or future header change. Measured via the
  // offsetTop chain, NOT getBoundingClientRect: rects include the pageIn
  // entrance transform (main starts at translateY(12px)), which skewed
  // load-time measurements; offset positions ignore transforms. The chain is
  // all in CSS space, so innerHeight (physical) is divided by the effective
  // zoom once. min-height still floors it.
  const frame = document.querySelector('.hero-frame')
  const logo = document.querySelector('header img[alt="MDMC"]')
  function pageTopCss(el) {
    let y = 0
    while (el) { y += el.offsetTop; el = el.offsetParent }
    return y
  }
  function sizeHero() {
    if (!frame || !logo) return
    frame.style.height = ''
    // The fold rule is a zoom-world concept. Below 1024 the frame is a 4:3
    // box sized by CSS, so this must not write a height over it — and the
    // clear above matters when resizing DOWN across the boundary, which would
    // otherwise leave a stale desktop pixel height inline.
    if (!matchMedia('(min-width: 1024px)').matches) return
    const zoomEl = document.querySelector('.zoom')
    const zoom = zoomEl ? parseFloat(getComputedStyle(zoomEl).zoom) || 1 : 1
    const logoBottom = pageTopCss(logo) + logo.offsetHeight
    const frameTop = pageTopCss(frame)
    const gapTop = frameTop - logoBottom
    const target = window.innerHeight / zoom - gapTop - frameTop
    if (target > 0) frame.style.height = `${target}px`
  }
  sizeHero()
  addEventListener('resize', sizeHero)
  // The webfont applies after this script runs and can change the header's
  // row height, so observe the header: any geometry change — font swap,
  // logo load, future header edits — re-derives the hero height.
  const header = document.querySelector('header')
  if (header && 'ResizeObserver' in window) new ResizeObserver(sizeHero).observe(header)
</script>
